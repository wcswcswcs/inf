    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug",
            "type": "debugpy",
            "request": "launch",
            "env": {"CUDA_VISIBLE_DEVICES": "0" },
            "program": "${workspaceFolder}/run_inference.py",
            "args": [
                "--input_dir", "Long3D/Classroom/images/scan_images",
                "--checkpoint_path", "./ckpt/checkpoints.pth",
                "--output_path","./inference_results_classroom.pth"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
    ]
}